APP_NAME=Web3 Online Radar
DATABASE_URL=postgres://go_radar:go_radar@127.0.0.1:5432/go_radar?sslmode=disable
GO_RADAR_ENV_FILE=
GO_RADAR_PORT=8080
GO_RADAR_ENABLE_SCHEDULER=false
GO_RADAR_AUTO_MIGRATE=true

# Telegram push settings. Leave empty to disable Telegram sending.
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_PROXY_URL=

# Network / proxy settings.
HTTP_TRUST_ENV=false
SELECTIVE_PROXY_URL=
SELECTIVE_PROXY_DOMAINS=gmgn.ai,api.telegram.org,api.gopluslabs.io,api.dexscreener.com,api.coingecko.com,fapi.binance.com,www.binance.com,eth.drpc.org

# Scanner switches.
ENABLE_SCANNER_S7=true
ENABLE_SCANNER_S5=true
ENABLE_SCANNER_S3=true
ENABLE_SCANNER_S2=true
ENABLE_SCANNER_S1=true
ENABLE_BINANCE_SQUARE=false
S5_ENABLE_DISCOVERY_SIGNALS=false

# Scanner intervals, seconds.
SCAN_INTERVAL_S7=1800
SCAN_INTERVAL_S5=600
SCAN_INTERVAL_S3=1800
SCAN_INTERVAL_S2=1800
SCAN_INTERVAL_S1=3600

# Scanner tuning.
S7_ETH_RPC_URL=https://eth.drpc.org
S7_MIN_NOTIFY_USD=0
S5_MOMENTUM_CONSECUTIVE_UP=3
S5_MOMENTUM_MEDIUM_QUOTA=1
S5_MIN_GAIN_PCT=5
S5_MIN_MC=1000
S5_MAX_MC=10000000
S5_MIN_LIQ=500
S5_SIGNAL_LOOKBACK=20
S3_VOL_SURGE_MULT=2.5
S3_MIN_VOL_USD=20000000
S3_MIN_OI_DELTA_PCT=3
S3_MIN_OI_USD=2000000
S3_TOP_VOLUME_LIMIT=100
S3_VOLUME_LOOKBACK_LIMIT=80
S3_ALWAYS_REPORT=true

OPENAI_API_KEY=sk-664af7d2c316ca7bae097ac8214c8f0d2c0b724b929085417598e613b3f20856
OPENAI_BASE_URL=https://xuseny.online/v1
OPENAI_MODEL=gpt-5.4

# Push policy.
SIGNAL_TIME_BUCKET_MINUTES=30
TOKEN_PUSH_COOLDOWN_MINUTES=180
WATCHLIST_COOLDOWN_MINUTES=30
S3_DIGEST_COOLDOWN_MINUTES=10
RESONANCE_LOOKBACK_MINUTES=360

# GMGN / HTTP provider behavior.
GMGN_TIMEOUT_SECONDS=15
GMGN_RETRIES=0
GMGN_CLI_TIMEOUT_SECONDS=240
GMGN_USER_AGENT=Mozilla/5.0
GMGN_API_KEY=gmgn_82ec373a27000d05510e37dabf04f002
GMGN_COOKIE=
