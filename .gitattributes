# 默认所有文本文件统一使用 LF 行尾，避免 Windows / Linux 两端因 CRLF 不一致
# 导致 Prettier / ESLint 等工具行为差异
* text=auto eol=lf

# 明确指定常见源代码与配置文件使用 LF
*.go        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.vue       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.less      text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.sh        text eol=lf
*.sql       text eol=lf
*.toml      text eol=lf
*.env       text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf

# Windows 专用脚本保持 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# 二进制文件不做行尾转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.zip       binary
*.tar       binary
*.gz        binary
*.pdf       binary
